{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "kaniz/impactpath",
  "type": "project",
  "description": "ImpactPath — Life Project career impact platform.",
  "require": {
    "php": "^8.2",
    "inertiajs/inertia-laravel": "^2.0",
    "laravel/framework": "^12.0",
    "laravel/tinker": "^2.10"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "laravel/pail": "^1.2",
    "laravel/pint": "^1.24",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"setup": ["composer install", "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"", "@php artisan key:generate", "@php artisan migrate --seed", "npm install", "npm run build"], "dev": ["Composer\\Config::disableProcessTimeout", "npx concurrently -c \"#93c5fd,#c4b5f6,#fca5a5,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"npm run dev\" \"php artisan pail --timeout=0\" --names=server,queue,vite,logs --kill-others"], "test": ["@php artisan config:clear", "@php vendor/bin/phpunit"]},
  "extra": {"laravel": {"dont-discover": []}},
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true},
  "minimum-stability": "stable",
  "prefer-stable": true
}
